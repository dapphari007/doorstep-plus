{
  "name": "doorstep-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "An accessible, privacy-first AI copilot for Ring doorbells, built on the Ring Partner API and Amazon Bedrock.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:bedrock": "node --env-file-if-exists=.env.local scripts/check-bedrock.mjs",
    "eval": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@strands-agents/sdk": "^1.20.0",
    "next": "^15.5.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
