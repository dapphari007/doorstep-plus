# ---------------------------------------------------------------------------
# Ring (pick ONE)
# ---------------------------------------------------------------------------
# Easiest: leave blank and paste a Playground token on the Settings page.
# Tokens: https://developer.amazon.com/ring/console/playground (~30 min lifetime)
# RING_ACCESS_TOKEN=
#
# Real devices via a Private App (auto-refreshing):
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# RING_WEBHOOK_SIGNING_KEY=        # HMAC key shown once at app registration
# RING_DEVICE_ID=                  # optional; defaults to the first device

# ---------------------------------------------------------------------------
# AWS (Amazon Bedrock + optional DynamoDB/S3)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# Either a Bedrock API key (Bedrock console → API keys):
# AWS_BEARER_TOKEN_BEDROCK=
# ...or normal AWS credentials (needed for DynamoDB/S3):
# AWS_PROFILE=default              # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# Default: Amazon Nova 2 Lite (cheap, no extra agreement needed).
# Claude works too after accepting the Anthropic agreement in the Bedrock console:
# PERCEPTION_MODEL_ID=anthropic.claude-haiku-5-5    # "anthropic.*" ids use the Bedrock Mantle client
# AGENT_MODEL_ID=us.anthropic.claude-haiku-5-5      # any Bedrock Converse model / inference profile
# PERCEPTION_MODEL_ID=us.amazon.nova-2-lite-v1:0
# AGENT_MODEL_ID=us.amazon.nova-2-lite-v1:0
# DDB_TABLE=doorstep-copilot       # partition key "pk" (S), sort key "sk" (S)
# S3_BUCKET=doorstep-copilot-snapshots

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
HOME_TIMEZONE=America/Los_Angeles
# POLL_INTERVAL_MS=4000
# POLL_BACKFILL=5
# LIGHT_WEBHOOK_URL=               # e.g. a Home Assistant webhook that flashes a lamp
# FIXTURE_MODE=true                # fake Ring + AI data for UI development only
